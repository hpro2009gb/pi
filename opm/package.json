{
	"name": "opm",
	"private": true,
	"type": "module",
	"bin": {
		"opm": "./src/cli.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": ["pi-package"],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"pi": {
